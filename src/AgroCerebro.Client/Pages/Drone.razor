@page "/drone"
@implements IAsyncDisposable
@inject HttpClient Http
@inject Session S
@inject IJSRuntime JS
<PageTitle>Drone</PageTitle>
<h1 class="h3"><i class="fa-solid fa-helicopter"></i> Mapeamento por drone</h1>
<p class="text-muted">Envie ortomosaicos/fotos georreferenciados (JPG/PNG exportados do WebODM, DJI Terra, Pix4D…). Informe os limites (sul, oeste, norte, leste) em graus ou ajuste pelo mapa e use o botão de limites.</p>
@if (S.PropriedadeId == 0) { <div class="alert alert-info">Selecione uma propriedade.</div> }
else
{
    <div class="cardx">
        <h2 class="h5">1. Missão de voo</h2>
        <p class="hint">Campos com <span class="req"></span> são obrigatórios.</p>
        <div class="row g-3">
            <div class="col-12 col-md-4 field"><label class="req" for="d-tal">Talhão sobrevoado</label>
                <select id="d-tal" class="form-select @Inv("talhao")" @bind="talhaoId" @bind:after="CarregarMissoes"><option value="0">Selecione…</option>@foreach (var t in talhoes) { <option value="@t.Id">@t.Nome</option> }</select>@Err("talhao")</div>
            <div class="col-6 col-md-2 field"><label class="req" for="d-data">Data do voo</label><input id="d-data" type="date" class="form-control" @bind="data" /></div>
            <div class="col-6 col-md-2 field"><label for="d-alt">Altura de voo (m)</label><input id="d-alt" type="number" step="any" min="1" max="500" class="form-control" placeholder="Ex.: 80" @bind="altura" /></div>
            <div class="col-12 col-md-4 field"><label for="d-eq">Equipamento</label><input id="d-eq" class="form-control" placeholder="Ex.: DJI Mavic 3M" maxlength="80" @bind="equip" /></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="CriarMissao" disabled="@busy">@(busy ? "Aguarde…" : "Criar missão")</button></div>
    </div>
    <div class="cardx">
        <h2 class="h5">2. Imagem georreferenciada</h2>
        <p class="hint">Os limites (sul/oeste/norte/leste) são as coordenadas dos cantos da imagem em graus decimais. Dá para ajustar o mapa abaixo e usar o botão para preencher.</p>
        <div class="row g-3">
            <div class="col-12 col-md-4 field"><label class="req" for="d-mis">Missão</label>
                <select id="d-mis" class="form-select @Inv("missao")" @bind="missaoId"><option value="0">Selecione…</option>@foreach (var m in missoes) { <option value="@m.Id">#@m.Id – @m.Data.ToString("dd/MM/yyyy")</option> }</select>@Err("missao")</div>
            <div class="col-6 col-md-3 field"><label for="d-tipo">Tipo de imagem</label>
                <select id="d-tipo" class="form-select" @bind="tipo"><option>RGB</option><option>NDVI</option><option>Multiespectral</option></select></div>
            <div class="col-6 col-md-2 field"><label for="d-gsd">Resolução (cm/pixel)</label><input id="d-gsd" type="number" step="any" min="0.1" class="form-control" placeholder="Ex.: 2.5" @bind="gsd" /><div class="hint">Opcional</div></div>
            <div class="col-12 col-md-3 field"><label class="req" for="d-arq">Arquivo (JPG, PNG ou WEBP)</label><InputFile id="d-arq" OnChange="Arquivo" accept="image/jpeg,image/png,image/webp" class="@("form-control " + Inv("arq"))" />@Err("arq")</div>
            <div class="col-6 col-md-3 field"><label class="req" for="d-s">Sul (latitude)</label><input id="d-s" type="number" step="any" min="-90" max="90" class="form-control @Inv("lim")" @bind="sul" /></div>
            <div class="col-6 col-md-3 field"><label class="req" for="d-o">Oeste (longitude)</label><input id="d-o" type="number" step="any" min="-180" max="180" class="form-control @Inv("lim")" @bind="oeste" /></div>
            <div class="col-6 col-md-3 field"><label class="req" for="d-n">Norte (latitude)</label><input id="d-n" type="number" step="any" min="-90" max="90" class="form-control @Inv("lim")" @bind="norte" /></div>
            <div class="col-6 col-md-3 field"><label class="req" for="d-l">Leste (longitude)</label><input id="d-l" type="number" step="any" min="-180" max="180" class="form-control @Inv("lim")" @bind="leste" /></div>
        </div>
        @Err("lim")
        <div class="form-actions"><button class="btn btn-outline-success" @onclick="LimitesDoMapa"><i class="fa-solid fa-ruler-combined"></i> Usar limites da vista do mapa</button>
            <button class="btn btn-primary" @onclick="Enviar" disabled="@busy">@(busy ? "Enviando…" : "Enviar imagem")</button></div>
        <div id="mapa" class="mapa mt-3" style="height:40vh"></div>
        <FormMsg Texto="@msg" Ok="@msgOk" />
    </div>
    <h2 class="h5">Imagens da missão</h2>
    <div class="grid">
    @foreach (var i in missoes.SelectMany(m => m.Imagens))
    { <div class="cardx"><img src="@i.Url" style="max-width:100%;max-height:160px" /><div class="small">#@i.Id @i.Tipo @(i.GsdCm != null ? $"· {i.GsdCm} cm/px" : "")</div></div> }
    </div>
}
@code {
    List<TalhaoDto> talhoes = new(); List<MissaoDroneDto> missoes = new();
    int talhaoId, missaoId; DateTime data = DateTime.Today; string? equip, msg, tipo = "RGB"; double? altura, gsd; double sul, oeste, norte, leste; IBrowserFile? arq;

    Dictionary<string, string> erros = new(); bool msgOk, busy;
    MarkupString Err(string k) => erros.TryGetValue(k, out var m) ? new MarkupString($"<div class='field-err'>{m}</div>") : default;
    string Inv(string k) => erros.ContainsKey(k) ? "invalid" : "";
    protected override async Task OnInitializedAsync()
    {
        try { if (S.PropriedadeId > 0) talhoes = await Http.GetFromJsonAsync<List<TalhaoDto>>($"api/propriedades/{S.PropriedadeId}/talhoes") ?? new(); }
        catch { msg = "Sem conexão."; }
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first && S.Propriedade is { } p) await JS.InvokeVoidAsync("mapa.init", "mapa", p.Latitude, p.Longitude);
    }
    async Task CarregarMissoes() { missoes = talhaoId == 0 ? new() : await Http.GetFromJsonAsync<List<MissaoDroneDto>>($"api/talhoes/{talhaoId}/missoes") ?? new(); }
    async Task CriarMissao()
    {
        erros.Clear();
        if (talhaoId == 0) { erros["talhao"] = "Escolha o talhão."; msgOk = false; msg = "Corrija os campos destacados."; return; }
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("api/missoes", new MissaoDroneRequest(talhaoId, data, equip, altura, null));
            msgOk = r.IsSuccessStatusCode;
            if (msgOk) { var m = await r.Content.ReadFromJsonAsync<MissaoDroneDto>(); missaoId = m!.Id; msg = "Missão criada. Agora envie a imagem no passo 2."; await CarregarMissoes(); }
            else msg = await Forms.ErroAsync(r, "Não foi possível criar a missão");
        }
        catch (Exception ex) { msgOk = false; msg = "Falha de conexão: " + ex.Message; }
        finally { busy = false; }
    }
    async Task LimitesDoMapa() { var b = await JS.InvokeAsync<double[]>("mapa.getBounds"); sul = b[0]; oeste = b[1]; norte = b[2]; leste = b[3]; }
    void Arquivo(InputFileChangeEventArgs e) => arq = e.File;
    async Task Enviar()
    {
        erros.Clear();
        if (missaoId == 0) erros["missao"] = "Escolha a missão (crie uma no passo 1).";
        if (arq == null) erros["arq"] = "Selecione a imagem.";
        else if (arq.Size > 50 * 1024 * 1024) erros["arq"] = "Arquivo acima de 50 MB. Reduza a resolução ou exporte em JPG.";
        if (norte <= sul || leste <= oeste) erros["lim"] = "Limites inválidos: o norte deve ser maior que o sul e o leste maior que o oeste (todos em graus).";
        if (erros.Count > 0) { msgOk = false; msg = "Corrija os campos destacados."; return; }
        busy = true;
        try
        {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            using var c = new MultipartFormDataContent();
            var f = new StreamContent(arq!.OpenReadStream(50 * 1024 * 1024));
            f.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(arq.ContentType);
            c.Add(f, "arquivo", arq.Name);
            c.Add(new StringContent(tipo ?? "RGB"), "tipo");
            c.Add(new StringContent(sul.ToString(inv)), "sul"); c.Add(new StringContent(oeste.ToString(inv)), "oeste");
            c.Add(new StringContent(norte.ToString(inv)), "norte"); c.Add(new StringContent(leste.ToString(inv)), "leste");
            if (gsd != null) c.Add(new StringContent(gsd.Value.ToString(inv)), "gsdCm");
            var r = await Http.PostAsync($"api/missoes/{missaoId}/imagens", c);
            msgOk = r.IsSuccessStatusCode;
            msg = msgOk ? "Imagem enviada com sucesso." : await Forms.ErroAsync(r, "Falha no envio");
            if (msgOk) await CarregarMissoes();
        }
        catch (Exception ex) { msgOk = false; msg = "Falha no envio: " + ex.Message; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync() { try { await JS.InvokeVoidAsync("mapa.dispose"); } catch { } }
}
