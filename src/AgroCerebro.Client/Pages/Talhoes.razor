@page "/talhoes"
@inject HttpClient Http
@inject Session S
<PageTitle>Talhões</PageTitle>
<h1 class="h3">Talhões</h1>
<FazendaChips />
@if (Pid == 0 && !S.Todas) { <div class="alert alert-info">Selecione ou cadastre uma propriedade.</div> }
else
{
    <p><a href="mapa"><i class="fa-solid fa-map-location-dot"></i> Desenhe o talhão no mapa</a> (área e polígono automáticos) ou cadastre manualmente abaixo.</p>
    @if (S.Todas)
    {
        <div class="fz-bar">
            <div class="field"><label for="t-filtro">Filtrar por fazenda</label>
                <select id="t-filtro" class="form-select" @bind="filtroFaz"><option value="0">Todas as fazendas</option>@foreach (var p in S.Propriedades) { <option value="@p.Id">@p.Nome</option> }</select></div>
        </div>
        <div class="fz-table-wrap"><table class="fz-table">
            <thead><tr><th>Fazenda</th><th>Talhão</th><th class="text-end">Área (ha)</th><th>Solo</th><th>Cultura / estágio</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in talhoes.Where(x => filtroFaz == 0 || x.PropriedadeId == filtroFaz).GroupBy(x => x.PropriedadeId))
            {
                @foreach (var t in g)
                {
                    <tr>
                        <td><span class="fz-tag"><i class="fa-solid fa-tractor"></i> @S.NomeFazenda(t.PropriedadeId)</span></td>
                        <td><strong>@t.Nome</strong></td>
                        <td class="text-end">@t.AreaHa.ToString("N2")</td>
                        <td>@(t.TipoSoloNome ?? "n/i")</td>
                        <td>@if (t.PlantioAtivo is { } pl) { <span><i class="fa-solid fa-seedling"></i> @pl.CulturaNome · BBCH @pl.BbchAtual</span> } else { <span class="text-muted small">Sem plantio</span> }</td>
                        <td><div class="fz-actions">
                            <button class="btn btn-sm btn-outline-success" @onclick="() => Abrir(t, 'p')">Plantio/BBCH</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => Abrir(t, 'o')"><i class="fa-solid fa-bug"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Abrir(t, 'e')"><i class="fa-solid fa-pen"></i></button>
                            <ConfirmaExcluir OnConfirmar="() => Excluir(t.Id)" /></div></td>
                    </tr>
                }
                <tr class="fz-sub"><td colspan="2">Subtotal – @S.NomeFazenda(g.Key)</td><td class="text-end">@g.Sum(x => x.AreaHa).ToString("N2")</td><td colspan="3">@g.Count() talhão(ões)</td></tr>
            }
            <tr class="fz-total"><td colspan="2">Total</td><td class="text-end">@talhoes.Where(x => filtroFaz == 0 || x.PropriedadeId == filtroFaz).Sum(x => x.AreaHa).ToString("N2")</td><td colspan="3">@talhoes.Count(x => filtroFaz == 0 || x.PropriedadeId == filtroFaz) talhão(ões)</td></tr>
            </tbody></table></div>
    }
    else
    {
    <div class="grid">
    @foreach (var t in talhoes)
    {
        <div class="cardx">
            <strong>@t.Nome</strong> <span class="small text-muted">@t.AreaHa.ToString("N2") ha · @(t.TipoSoloNome ?? "solo n/i")</span>
            @if (t.PlantioAtivo is { } pl)
            {
                <div><i class="fa-solid fa-seedling"></i> @pl.CulturaNome — plantio @pl.DataPlantio.ToString("dd/MM/yyyy")</div>
                <div class="small">BBCH @pl.BbchAtual: @Bbch.Estagio(pl.BbchAtual)</div>
            }
            else { <div class="text-muted small">Sem plantio ativo</div> }
            <div class="mt-2 d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-success" @onclick="() => Abrir(t, 'p')">Plantio/BBCH</button>
                <button class="btn btn-sm btn-outline-warning" @onclick="() => Abrir(t, 'o')"><i class="fa-solid fa-bug"></i> Praga</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Abrir(t, 'e')">Editar</button>
                <ConfirmaExcluir OnConfirmar="() => Excluir(t.Id)" />
            </div>
        </div>
    }
    </div>
    }

    @if (sel != null && modo == 'p')
    {
        <div class="cardx">
            <h2 class="h5">Plantio / estágio – @sel.Nome</h2>
            <div class="row g-3">
                <div class="col-12 col-md-4 field"><label class="req" for="t-cult">Cultura</label>
                    <select id="t-cult" class="form-select" @bind="culturaId">@foreach (var c in culturas) { <option value="@c.Id">@c.Nome</option> }</select></div>
                <div class="col-12 col-md-4 field"><label class="req" for="t-data">Data do plantio</label><input id="t-data" type="date" class="form-control @Inv("data")" @bind="dataPlantio" />@Err("data")</div>
                <div class="col-12 col-md-4 field"><label for="t-bbch">Estágio BBCH: <strong>@bbch</strong> – @Bbch.Estagio(bbch)</label>
                    <input id="t-bbch" type="range" min="0" max="99" class="form-range" @bind="bbch" @bind:event="oninput" />
                    <div class="hint">0 = semente/germinação · 99 = colheita/pós-colheita</div></div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SalvarPlantio" disabled="@busy">@(busy ? "Salvando…" : "Salvar plantio")</button>
                @if (sel.PlantioAtivo != null)
                {
                    <button class="btn btn-outline-success" @onclick="Monitorar" disabled="@busy">Registrar monitoramento (BBCH @bbch)</button>
                    <button class="btn btn-outline-secondary" @onclick="AtualizarPlantioAtivo" disabled="@busy">Atualizar este plantio</button>
                    <button class="btn btn-outline-secondary" @onclick="EncerrarCiclo" disabled="@busy">Encerrar ciclo</button>
                    <ConfirmaExcluir Texto="Excluir plantio" OnConfirmar="ExcluirPlantio" />
                }
            </div>
            <FormMsg Texto="@msg" Ok="@msgOk" />
            @if (monits.Count > 0)
            {
                <h3 class="h6 mt-3">Histórico de monitoramento</h3>
                <ul class="list-unstyled small">@foreach (var m in monits) { <li class="d-flex gap-2 align-items-center mb-1">@m.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – BBCH @m.Bbch @m.Notas <ConfirmaExcluir Texto="" OnConfirmar="() => ExcluirMonit(m.Id)" /></li> }</ul>
            }
        </div>
    }
    @if (sel != null && modo == 'o')
    {
        <div class="cardx">
            <h2 class="h5">Ocorrência de praga – @sel.Nome</h2>
            <div class="row g-3">
                <div class="col-12 col-md-5 field"><label class="req" for="o-praga">Praga ou doença observada</label>
                    <select id="o-praga" class="form-select" @bind="pragaId">@foreach (var g in pragas) { <option value="@g.Id">@g.Nome (@g.Tipo)</option> }</select></div>
                <div class="col-12 col-md-4 field"><label for="o-sev">Severidade: <strong>@sev</strong> de 5</label>
                    <input id="o-sev" type="range" min="0" max="5" class="form-range" @bind="sev" @bind:event="oninput" />
                    <div class="hint">0 = ausente · 3 = moderada · 5 = infestação severa</div></div>
                <div class="col-12 col-md-3 field"><label for="o-notas">Observações</label><input id="o-notas" class="form-control" placeholder="Ex.: borda do talhão" maxlength="500" @bind="notas" /><div class="hint">Opcional</div></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" @onclick="SalvarOcorrencia" disabled="@busy">@(busy ? "Salvando…" : ocEditId == 0 ? "Registrar ocorrência" : "Salvar alterações")</button>
                @if (ocEditId != 0) { <button class="btn btn-link" @onclick="CancelaOc">Cancelar edição</button> }</div>
            <FormMsg Texto="@msg" Ok="@msgOk" />
            <ul class="list-unstyled mt-2">@foreach (var o in ocorrencias) { <li class="d-flex gap-2 align-items-center flex-wrap mb-1">@o.Data.ToLocalTime().ToString("dd/MM") – @o.PragaNome (sev @o.Severidade) @o.Notas
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditaOc(o)"><i class="fa-solid fa-pen"></i></button>
                <ConfirmaExcluir Texto="" OnConfirmar="() => ExcluirOc(o.Id)" /></li> }</ul>
        </div>
    }
    @if (modo == 'n' || modo == 'e')
    {
        <div class="cardx">
            <h2 class="h5">@(modo == 'e' ? "Editar talhão" : "Novo talhão")</h2>
            <p class="hint">Campos com <span class="req"></span> são obrigatórios. Dica: desenhando no mapa a área é calculada sozinha.</p>
            <div class="row g-3">
                @if (S.Todas && modo == 'n')
                {
                    <div class="col-12 field"><label class="req" for="t-faz">Fazenda do talhão</label>
                        <select id="t-faz" class="form-select" @bind="novaFaz">@foreach (var p in S.Propriedades) { <option value="@p.Id">@p.Nome</option> }</select></div>
                }
                <div class="col-12 col-md-5 field"><label class="req" for="t-nome">Nome do talhão</label>
                    <input id="t-nome" class="form-control @Inv("nome")" placeholder="Ex.: Talhão 3 – Soja" maxlength="120" @bind="nome" />@Err("nome")</div>
                <div class="col-6 col-md-3 field"><label class="req" for="t-area">Área (hectares)</label>
                    <input id="t-area" type="number" step="any" min="0.01" class="form-control @Inv("area")" @bind="area" />@Err("area")</div>
                <div class="col-6 col-md-4 field"><label for="t-solo">Tipo de solo</label>
                    <select id="t-solo" class="form-select" @bind="soloId"><option value="0">Não informado</option>@foreach (var s in solos) { <option value="@s.Id">@s.Nome (@s.Textura)</option> }</select></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" @onclick="SalvarTalhao" disabled="@busy">@(busy ? "Salvando…" : "Salvar talhão")</button>
                <button class="btn btn-link" @onclick="() => modo = ' '">Cancelar</button></div>
            <FormMsg Texto="@msg" Ok="@msgOk" />
        </div>
    }
    else { <button class="btn btn-primary" @onclick="Novo">+ Novo talhão</button> }
    @if (modo != 'n' && modo != 'e' && modo != 'p' && modo != 'o') { <FormMsg Texto="@msg" Ok="@msgOk" /> }
}
@code {
    int Pid => S.Todas ? -1 : (S.PropriedadeId > 0 ? S.PropriedadeId : S.Propriedades.FirstOrDefault()?.Id ?? 0);
    int filtroFaz, novaFaz; int FazForm => S.Todas ? novaFaz : Pid;
    List<TalhaoDto> talhoes = new(); List<CulturaDto> culturas = new(); List<PragaDto> pragas = new(); List<TipoSoloDto> solos = new(); List<OcorrenciaPragaDto> ocorrencias = new();
    TalhaoDto? sel; char modo = ' '; string nome = "", notas = "", msg = ""; double area; int soloId, culturaId, pragaId, bbch = 10, sev = 1, ocEditId; List<MonitoramentoDto> monits = new(); DateTime dataPlantio = DateTime.Today;

    Dictionary<string, string> erros = new(); bool msgOk, busy;
    MarkupString Err(string k) => erros.TryGetValue(k, out var m) ? new MarkupString($"<div class='field-err'>{m}</div>") : default;
    string Inv(string k) => erros.ContainsKey(k) ? "invalid" : "";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            culturas = await Http.GetFromJsonAsync<List<CulturaDto>>("api/catalogo/culturas") ?? new();
            pragas = await Http.GetFromJsonAsync<List<PragaDto>>("api/catalogo/pragas") ?? new();
            solos = await Http.GetFromJsonAsync<List<TipoSoloDto>>("api/catalogo/solos") ?? new();
            if (culturas.Count > 0) culturaId = culturas[0].Id;
            if (pragas.Count > 0) pragaId = pragas[0].Id;
            novaFaz = S.Propriedades.FirstOrDefault()?.Id ?? 0;
            await Carregar();
        }
        catch { msg = "Sem conexão com o servidor."; }
    }
    async Task Carregar()
    {
        if (S.Todas) talhoes = (await Http.GetFromJsonAsync<List<TalhaoFazendaDto>>("api/todas/talhoes") ?? new()).Select(x => x.Talhao).ToList();
        else if (Pid > 0) talhoes = await Http.GetFromJsonAsync<List<TalhaoDto>>($"api/propriedades/{Pid}/talhoes") ?? new();
    }
    async Task Abrir(TalhaoDto t, char m)
    {
        sel = t; modo = m;
        if (m == 'p' && t.PlantioAtivo != null) { culturaId = t.PlantioAtivo.CulturaId; bbch = t.PlantioAtivo.BbchAtual; dataPlantio = t.PlantioAtivo.DataPlantio; }
        if (m == 'e') { nome = t.Nome; area = t.AreaHa; soloId = t.TipoSoloId ?? 0; }
        if (m == 'p' && t.PlantioAtivo != null) monits = await Http.GetFromJsonAsync<List<MonitoramentoDto>>($"api/plantios/{t.PlantioAtivo.Id}/monitoramentos") ?? new(); else monits = new();
        ocEditId = 0;
        if (m == 'o') ocorrencias = await Http.GetFromJsonAsync<List<OcorrenciaPragaDto>>($"api/talhoes/{t.Id}/ocorrencias") ?? new();
    }
    void Novo() { sel = null; modo = 'n'; nome = ""; area = 0; soloId = 0; erros.Clear(); msg = ""; }
    async Task<bool> Envia(Func<Task<HttpResponseMessage>> f, string ok, string falha)
    {
        busy = true;
        try { var r = await f(); msgOk = r.IsSuccessStatusCode; msg = msgOk ? ok : await Forms.ErroAsync(r, falha); return msgOk; }
        catch (Exception ex) { msgOk = false; msg = "Falha de conexão: " + ex.Message; return false; }
        finally { busy = false; }
    }
    async Task SalvarTalhao()
    {
        erros.Clear();
        if (Forms.Obrigatorio(nome, "o nome do talhão") is { } e1) erros["nome"] = e1;
        if (area <= 0) erros["area"] = "A área deve ser maior que zero.";
        if (erros.Count > 0) { msgOk = false; msg = "Corrija os campos destacados."; return; }
        var req = new TalhaoSalvarRequest(nome.Trim(), area, sel?.GeoJson, soloId == 0 ? null : soloId);
        if (await Envia(() => modo == 'e' ? Http.PutAsJsonAsync($"api/talhoes/{sel!.Id}", req) : Http.PostAsJsonAsync($"api/propriedades/{FazForm}/talhoes", req), "Talhão salvo.", "Não foi possível salvar o talhão")) { modo = ' '; await Carregar(); }
    }
    async Task SalvarPlantio()
    {
        erros.Clear();
        if (dataPlantio.Year < 2000 || dataPlantio > DateTime.Today.AddYears(1)) { erros["data"] = "Informe uma data de plantio válida."; msgOk = false; msg = "Corrija os campos destacados."; return; }
        if (await Envia(() => Http.PostAsJsonAsync($"api/talhoes/{sel!.Id}/plantio", new PlantioSalvarRequest(culturaId, dataPlantio, bbch)), "Plantio salvo.", "Não foi possível salvar o plantio")) { modo = ' '; await Carregar(); }
    }
    async Task Monitorar()
    {
        if (await Envia(() => Http.PostAsJsonAsync("api/monitoramentos", new MonitoramentoRequest(sel!.PlantioAtivo!.Id, bbch, null)), "Monitoramento registrado.", "Não foi possível registrar")) { modo = ' '; await Carregar(); }
    }
    async Task SalvarOcorrencia()
    {
        if (await Envia(() => ocEditId == 0 ? Http.PostAsJsonAsync("api/ocorrencias", new OcorrenciaPragaRequest(sel!.Id, pragaId, sev, null, null, notas)) : Http.PutAsJsonAsync($"api/ocorrencias/{ocEditId}", new OcorrenciaPragaEditarRequest(pragaId, sev, notas)), ocEditId == 0 ? "Ocorrência registrada." : "Ocorrência atualizada.", "Não foi possível salvar"))
        {
            notas = ""; ocEditId = 0;
            ocorrencias = await Http.GetFromJsonAsync<List<OcorrenciaPragaDto>>($"api/talhoes/{sel!.Id}/ocorrencias") ?? new();
        }
    }
    void EditaOc(OcorrenciaPragaDto o) { ocEditId = o.Id; pragaId = o.PragaId; sev = o.Severidade; notas = o.Notas ?? ""; msg = ""; }
    void CancelaOc() { ocEditId = 0; notas = ""; }
    async Task RecarregaOc() => ocorrencias = await Http.GetFromJsonAsync<List<OcorrenciaPragaDto>>($"api/talhoes/{sel!.Id}/ocorrencias") ?? new();
    async Task ExcluirOc(int id) { if (await Envia(() => Http.DeleteAsync($"api/ocorrencias/{id}"), "Ocorrência excluída.", "Não foi possível excluir")) await RecarregaOc(); }
    async Task AtualizarPlantioAtivo()
    {
        if (await Envia(() => Http.PutAsJsonAsync($"api/plantios/{sel!.PlantioAtivo!.Id}", new PlantioEditarRequest(culturaId, dataPlantio, bbch, true)), "Plantio atualizado.", "Não foi possível atualizar")) { modo = ' '; await Carregar(); }
    }
    async Task EncerrarCiclo()
    {
        if (await Envia(() => Http.PutAsJsonAsync($"api/plantios/{sel!.PlantioAtivo!.Id}", new PlantioEditarRequest(sel.PlantioAtivo.CulturaId, sel.PlantioAtivo.DataPlantio, sel.PlantioAtivo.BbchAtual, false)), "Ciclo encerrado.", "Não foi possível encerrar")) { modo = ' '; await Carregar(); }
    }
    async Task ExcluirPlantio()
    {
        if (await Envia(() => Http.DeleteAsync($"api/plantios/{sel!.PlantioAtivo!.Id}"), "Plantio excluído.", "Não foi possível excluir")) { modo = ' '; await Carregar(); }
    }
    async Task ExcluirMonit(int id)
    {
        if (await Envia(() => Http.DeleteAsync($"api/monitoramentos/{id}"), "Registro excluído.", "Não foi possível excluir")) monits = await Http.GetFromJsonAsync<List<MonitoramentoDto>>($"api/plantios/{sel!.PlantioAtivo!.Id}/monitoramentos") ?? new();
    }
    async Task Excluir(int id) { await Http.DeleteAsync($"api/talhoes/{id}"); await Carregar(); }
}
