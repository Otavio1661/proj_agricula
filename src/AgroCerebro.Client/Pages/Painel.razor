@page "/"
@inject HttpClient Http
@inject Session S
<PageTitle>Painel – AgroCérebro</PageTitle>
<h1 class="h3">Painel</h1>
@if (S.PropriedadeId == 0) { <div class="alert alert-info">Cadastre sua primeira propriedade em <a href="propriedades">Fazendas</a>.</div> }
@if (erro != null) { <div class="alert alert-warning">@erro</div> }
@if (p != null)
{
    <div class="grid">
        <div class="cardx"><div class="small text-muted">Propriedades</div><div class="stat">@p.Propriedades</div></div>
        <div class="cardx"><div class="small text-muted">Talhões</div><div class="stat">@p.Talhoes</div></div>
        <div class="cardx"><div class="small text-muted">Área total</div><div class="stat">@p.AreaTotalHa.ToString("N1") ha</div></div>
        <div class="cardx"><div class="small text-muted">Alertas não lidos</div><div class="stat">@p.AlertasNaoLidos</div></div>
        @if (clima != null)
        {
            <div class="cardx"><div class="small text-muted">Agora na fazenda</div>
                <div class="stat">@clima.TemperaturaAtualC.ToString("N1") °C</div>
                <div><i class="fa-solid fa-droplet"></i> @clima.UmidadeAtualPct.ToString("N0")% · <i class="fa-solid fa-wind"></i> @clima.VentoAtualKmh.ToString("N0") km/h</div></div>
        }
    </div>
    <h2 class="h5 mt-3"><i class="fa-solid fa-brain"></i> Melhores janelas de aplicação</h2>
    @if (p.Recomendacoes.Count == 0) { <p class="text-muted">Sem recomendações — cadastre talhões com plantio ativo.</p> }
    <div class="grid">
        @foreach (var r in p.Recomendacoes.Take(6))
        {
            <div class="cardx">
                <span class="badge badge-@r.Status.ToLower()">@r.Status</span> <strong>@r.BioinsumoNome</strong>
                <div class="small text-muted">@r.TalhaoNome</div>
                <div>@r.Motivo</div>
                @foreach (var j in r.Janelas.Take(2)) { <div class="small"><i class="fa-solid fa-clock"></i> @j.Inicio.ToString("dd/MM HH:mm") – @j.Fim.ToString("HH:mm")</div> }
            </div>
        }
    </div>
    <h2 class="h5 mt-3"><i class="fa-solid fa-bell"></i> Últimos alertas</h2>
    @foreach (var a in p.UltimosAlertas)
    { <div class="cardx nivel-@a.Nivel"><strong>@a.Titulo</strong><div>@a.Mensagem</div><div class="small text-muted">@a.CriadoEm.ToLocalTime().ToString("g")</div></div> }
}
@code {
    PainelDto? p; ClimaDto? clima; string? erro;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            p = await Http.GetFromJsonAsync<PainelDto>("api/painel");
            if (S.PropriedadeId > 0) clima = await Http.GetFromJsonAsync<ClimaDto>($"api/propriedades/{S.PropriedadeId}/clima");
        }
        catch (Exception) { erro = "Não foi possível carregar tudo (offline?)."; }
    }
}
