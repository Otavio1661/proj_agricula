@page "/recomendacoes"
@inject HttpClient Http
@inject Session S
<PageTitle>Recomendações</PageTitle>
<h1 class="h3">🧠 Recomendações de aplicação</h1>
<p class="text-muted">Cruzamos clima (72h), estágio BBCH, pragas e os requisitos biológicos de cada bioinsumo.</p>
@if (erro != null) { <div class="alert alert-warning">@erro</div> }
@if (lista == null && erro == null) { <p>Calculando…</p> }
@if (lista is { Count: 0 }) { <p class="text-muted">Nenhuma recomendação. Cadastre talhões com plantio ativo.</p> }
<div class="grid">
@foreach (var r in lista ?? new())
{
    <div class="cardx">
        <span class="badge badge-@r.Status.ToLower()">@r.Status</span>
        <strong>@r.BioinsumoNome</strong>
        <div class="small text-muted">@r.TalhaoNome @(r.Pragas.Count > 0 ? "· alvo: " + string.Join(", ", r.Pragas) : "")</div>
        <p class="mb-1">@r.Motivo</p>
        @foreach (var j in r.Janelas)
        { <div class="small">⏰ <strong>@j.Inicio.ToString("ddd dd/MM HH:mm")</strong> → @j.Fim.ToString("HH:mm") (nota @j.Pontuacao.ToString("N0")) – @j.Resumo</div> }
    </div>
}
</div>
@code {
    List<RecomendacaoDto>? lista; string? erro;
    protected override async Task OnInitializedAsync()
    {
        try { if (S.PropriedadeId > 0) lista = await Http.GetFromJsonAsync<List<RecomendacaoDto>>($"api/propriedades/{S.PropriedadeId}/recomendacoes"); }
        catch { erro = "Recomendações indisponíveis (offline?)."; }
    }
}
