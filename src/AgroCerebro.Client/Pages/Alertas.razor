@page "/alertas"
@inject HttpClient Http
@inject Session S
<PageTitle>Alertas</PageTitle>
<h1 class="h3"><i class="fa-solid fa-bell"></i> Alertas</h1>
<button class="btn btn-sm btn-primary mb-2" @onclick="Gerar" disabled="@(S.PropriedadeId == 0)">Avaliar agora</button> <span class="small">@msg</span>
@if (erro != null) { <div class="alert alert-warning">@erro</div> }
@if (lista.Count == 0 && erro == null) { <p class="text-muted">Sem alertas.</p> }
@foreach (var a in lista)
{
    <div class="cardx nivel-@a.Nivel" style="@(a.Lido ? "opacity:.6" : "")">
        <div class="d-flex justify-content-between"><strong>@a.Titulo</strong><span class="small text-muted">@a.Tipo · @a.CriadoEm.ToLocalTime().ToString("g")</span></div>
        <div>@a.Mensagem</div>
        @if (!a.Lido) { <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => Lido(a.Id)">Marcar como lido</button> }
    </div>
}
@code {
    List<AlertaDto> lista = new(); string? erro, msg;
    async Task Gerar()
    {
        var r = await Http.PostAsync($"api/propriedades/{S.PropriedadeId}/alertas/gerar", null);
        msg = r.IsSuccessStatusCode ? $"{await r.Content.ReadAsStringAsync()} novo(s) alerta(s) gerado(s)." : "Falha ao avaliar.";
        await Carregar();
    }
    protected override async Task OnInitializedAsync() => await Carregar();
    async Task Carregar()
    {
        try { if (S.PropriedadeId > 0) lista = await Http.GetFromJsonAsync<List<AlertaDto>>($"api/propriedades/{S.PropriedadeId}/alertas") ?? new(); }
        catch { erro = "Alertas indisponíveis (offline?)."; }
    }
    async Task Lido(int id) { await Http.PostAsync($"api/alertas/{id}/lido", null); await Carregar(); }
}
