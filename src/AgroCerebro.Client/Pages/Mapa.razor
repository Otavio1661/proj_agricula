@page "/mapa"
@implements IAsyncDisposable
@inject HttpClient Http
@inject Session S
@inject IJSRuntime JS
<PageTitle>Mapa</PageTitle>
<h1 class="h3">@(S.Todas ? "Mapa de todas as fazendas" : "Mapa da propriedade")</h1>
<FazendaChips />
@if (S.Todas && cores.Count > 0)
{
    <div class="fz-legend">
        @foreach (var f in S.Propriedades)
        {
            <span class="fz-legend-item"><span class="sw" style="background:@cores[f.Id]"></span> @f.Nome
                <button type="button" title="Aproximar" @onclick="() => Zoom(f)"><i class="fa-solid fa-magnifying-glass-location"></i></button>
                <button type="button" title="Abrir esta fazenda" @onclick="() => S.SelecionarAsync(f.Id)"><i class="fa-solid fa-arrow-right"></i></button></span>
        }
        <button type="button" class="fz-chip" @onclick='() => JS.InvokeVoidAsync("mapa.fitAll")'><i class="fa-solid fa-expand"></i> Enquadrar tudo</button>
    </div>
    <p class="hint">Para desenhar um talhão, abra uma fazenda específica (botão <i class="fa-solid fa-arrow-right"></i> na legenda).</p>
}
<div class="d-flex gap-2 flex-wrap mb-2 align-items-center">
    @if (S.Todas) { }
    else if (!desenhando) { <button class="btn btn-primary btn-sm" @onclick="Iniciar"><i class="fa-solid fa-pen"></i> Desenhar talhão</button> }
    else
    {
        <button class="btn btn-success btn-sm" @onclick="Concluir"><i class="fa-solid fa-check"></i> Concluir</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick='() => JS.InvokeVoidAsync("mapa.undo")'><i class="fa-solid fa-rotate-left"></i> Desfazer ponto</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="Cancelar">Cancelar</button>
        <span class="small">Toque no mapa para marcar os vértices.</span>
    }
</div>
@if (novo != null)
{
    <div class="cardx">
        <h2 class="h5">Novo talhão</h2>
        <p class="hint">Área calculada pelo desenho: <strong>@novo.Value.areaHa.ToString("N2") ha</strong></p>
        <div class="field"><label class="req" for="m-nome">Nome do talhão</label>
            <input id="m-nome" class="form-control @(erroNome != null ? "invalid" : "")" maxlength="120" placeholder="Ex.: Talhão 1 – Milho" @bind="nome" />
            @if (erroNome != null) { <div class="field-err">@erroNome</div> }</div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="SalvarNovo" disabled="@busy">@(busy ? "Salvando…" : "Salvar talhão")</button>
            <button class="btn btn-link" @onclick="() => novo = null">Descartar</button></div>
    </div>
}
<div id="mapa" class="mapa"></div>
@if (imagens.Count > 0)
{
    <div class="cardx mt-2">
        <strong>Imagens de drone</strong>
        @foreach (var i in imagens)
        {
            <div class="d-flex gap-2 align-items-center flex-wrap small mt-1">
                <span>#@i.Id (@i.Tipo)</span>
                <input type="range" min="0" max="1" step="0.05" value="0.8" @oninput="e => Opac(i.Id, e)" />
                <label><input type="checkbox" @onchange="e => Vari(i.Id, e)" /> Índice de vegetação (VARI)</label>
            </div>
        }
    </div>
}
<FormMsg Texto="@msg" Ok="@msgOk" />
@code {
    List<TalhaoDto> talhoes = new(); List<ImagemDroneDto> imagens = new();
    bool desenhando; (string geoJson, double areaHa)? novo; string nome = "", msg = "", erroNome; bool msgOk, busy;

    class Res { public string geoJson { get; set; } = ""; public double areaHa { get; set; } }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        if (S.Todas) { await RecarregarTodas(); return; }
        var p = S.Propriedade ?? S.Propriedades.FirstOrDefault(); if (p == null) { msg = "Cadastre uma propriedade primeiro."; StateHasChanged(); return; }
        await JS.InvokeVoidAsync("mapa.init", "mapa", p.Latitude, p.Longitude);
        await Recarregar();
    }
    static readonly string[] Paleta = { "#7CFC00", "#00E5FF", "#FFD600", "#FF4081", "#B388FF", "#FF9100", "#69F0AE", "#40C4FF" };
    Dictionary<int, string> cores = new();
    async Task RecarregarTodas()
    {
        try
        {
            var ts = await Http.GetFromJsonAsync<List<TalhaoFazendaDto>>("api/todas/talhoes") ?? new();
            cores = S.Propriedades.Select((p, i) => (p.Id, Paleta[i % Paleta.Length])).ToDictionary(x => x.Id, x => x.Item2);
            var fazendas = S.Propriedades.Select(p => new
            {
                id = p.Id, nome = p.Nome, lat = p.Latitude, lon = p.Longitude, cor = cores[p.Id],
                talhoes = ts.Where(t => t.Talhao.PropriedadeId == p.Id).Select(t => new { id = t.Talhao.Id, nome = t.Talhao.Nome, geoJson = t.Talhao.GeoJson })
            });
            await JS.InvokeVoidAsync("mapa.initTodas", "mapa", fazendas);
            var ms = await Http.GetFromJsonAsync<List<MissaoFazendaDto>>("api/todas/missoes") ?? new();
            imagens = ms.SelectMany(m => m.Missao.Imagens).ToList();
            foreach (var i in imagens) await JS.InvokeVoidAsync("mapa.addOverlayQuiet", i.Id, i.Url, new[] { i.Sul, i.Oeste, i.Norte, i.Leste });
            StateHasChanged();
        }
        catch { msg = "Dados do mapa indisponíveis (offline?)."; StateHasChanged(); }
    }
    async Task Zoom(PropriedadeDto f) => await JS.InvokeVoidAsync("mapa.focus", f.Latitude, f.Longitude, 14);
    async Task Recarregar()
    {
        try
        {
            talhoes = await Http.GetFromJsonAsync<List<TalhaoDto>>($"api/propriedades/{(S.PropriedadeId > 0 ? S.PropriedadeId : S.Propriedades.First().Id)}/talhoes") ?? new();
            await JS.InvokeVoidAsync("mapa.setTalhoes", talhoes.Select(t => new { id = t.Id, nome = t.Nome, geoJson = t.GeoJson }));
            imagens.Clear();
            foreach (var t in talhoes)
            {
                var ms = await Http.GetFromJsonAsync<List<MissaoDroneDto>>($"api/talhoes/{t.Id}/missoes") ?? new();
                imagens.AddRange(ms.SelectMany(m => m.Imagens));
            }
            foreach (var i in imagens)
                await JS.InvokeVoidAsync("mapa.addOverlay", i.Id, i.Url, new[] { i.Sul, i.Oeste, i.Norte, i.Leste }, i.Tipo);
            StateHasChanged();
        }
        catch { msg = "Dados do mapa indisponíveis (offline?)."; StateHasChanged(); }
    }
    async Task Iniciar() { desenhando = true; novo = null; await JS.InvokeVoidAsync("mapa.startDraw"); }
    async Task Cancelar() { desenhando = false; await JS.InvokeVoidAsync("mapa.cancelDraw"); }
    async Task Concluir()
    {
        desenhando = false;
        var r = await JS.InvokeAsync<Res?>("mapa.finishDraw");
        if (r == null) { msgOk = false; msg = "Marque ao menos 3 pontos no mapa para formar o talhão."; return; }
        novo = (r.geoJson, r.areaHa); nome = $"Talhão {talhoes.Count + 1}";
    }
    async Task SalvarNovo()
    {
        erroNome = Forms.Obrigatorio(nome, "o nome do talhão");
        if (erroNome != null) return;
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync($"api/propriedades/{(S.PropriedadeId > 0 ? S.PropriedadeId : S.Propriedades.First().Id)}/talhoes", new TalhaoSalvarRequest(nome.Trim(), novo!.Value.areaHa, novo.Value.geoJson, null));
            msgOk = r.IsSuccessStatusCode;
            msg = msgOk ? "Talhão salvo." : await Forms.ErroAsync(r, "Não foi possível salvar o talhão");
            if (msgOk) { novo = null; await Recarregar(); }
        }
        catch (Exception ex) { msgOk = false; msg = "Falha de conexão: " + ex.Message; }
        finally { busy = false; }
    }
    async Task Opac(int id, ChangeEventArgs e) => await JS.InvokeVoidAsync("mapa.setOpacity", id, double.Parse(e.Value!.ToString()!, System.Globalization.CultureInfo.InvariantCulture));
    async Task Vari(int id, ChangeEventArgs e) => await JS.InvokeVoidAsync("mapa.setVari", id, (bool)e.Value!);
    public async ValueTask DisposeAsync() { try { await JS.InvokeVoidAsync("mapa.dispose"); } catch { } }
}
