@inherits LayoutComponentBase
@implements IDisposable
@inject Session S
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!S.Carregado) { <p class="p-3">Carregando…</p> }
else if (Nav.Uri.Contains("/login")) { @Body }
else if (S.Autenticado)
{
    <div class="app-shell">
        <nav class="side">
            <div class="brand"><i class="fa-solid fa-seedling"></i> AgroCérebro</div>
            @foreach (var g in Itens.Select(i => i.Item4).Distinct())
            {
                <div class="nav-group">@g</div>
                @foreach (var (href, ico, nome, _) in Itens.Where(i => i.Item4 == g))
                { <NavLink href="@href" Match="@(href=="" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><i class="@ico"></i> @nome</NavLink> }
            }
            <div class="side-foot">Manejo de bioinsumos · v1</div>
        </nav>
        <div class="main">
            <div class="topbar">
                <span class="logo-m"><i class="fa-solid fa-seedling"></i></span>
                <select class="form-select form-select-sm" value="@S.PropriedadeId" @onchange="Troca" aria-label="Propriedade">
                    @if (S.Propriedades.Count == 0) { <option value="0">Sem propriedade</option> }
                    @if (S.Propriedades.Count > 1) { <option value="-1">Todas as fazendas (@S.Propriedades.Count)</option> }
                    @foreach (var p in S.Propriedades) { <option value="@p.Id">@p.Nome</option> }
                </select>
                <span class="ms-auto small d-none d-sm-inline"><span class="dot @(online ? "" : "off")"></span> @(online ? "Online" : "Offline")</span>
                <span class="d-sm-none ms-auto"><span class="dot @(online ? "" : "off")"></span></span>
                <span class="avatar" title="@S.Usuario?.Nome">@Inicial</span>
                <span class="small fw-semibold d-none d-md-inline">@S.Usuario?.Nome</span>
                <button class="btn btn-sm btn-outline-secondary d-none d-md-inline-block" @onclick="Sair"><i class="fa-solid fa-right-from-bracket"></i> Sair</button>
            </div>
            <div class="content" @key="S.PropriedadeId">@Body</div>
        </div>
        <nav class="tabbar">
            @foreach (var (href, ico, nome, _) in Itens.Take(4))
            { <NavLink href="@href" Match="@(href=="" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><i class="@ico"></i>@nome</NavLink> }
            <button @onclick="() => mais = !mais"><i class="fa-solid fa-grip"></i>Mais</button>
        </nav>
        @if (mais)
        {
            <div class="sheet-bg" @onclick="() => mais = false"></div>
            <div class="sheet" @onclick="() => mais = false">
                @foreach (var (href, ico, nome, _) in Itens.Skip(4))
                { <NavLink href="@href" Match="@(href=="" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><i class="@ico"></i>@nome</NavLink> }
                <button @onclick="Sair"><i class="fa-solid fa-right-from-bracket"></i>Sair</button>
            </div>
        }
    </div>
}
else { <p class="p-3">Redirecionando…</p> }

@code {
    bool online = true, mais;
    string Inicial => string.IsNullOrWhiteSpace(S.Usuario?.Nome) ? "?" : S.Usuario!.Nome.Trim()[..1].ToUpperInvariant();
    static readonly (string, string, string, string)[] Itens = {
        ("", "fa-solid fa-house", "Painel", "Visão geral"), ("mapa", "fa-solid fa-map-location-dot", "Mapa", "Visão geral"),
        ("talhoes", "fa-solid fa-wheat-awn", "Talhões", "Operação"), ("alertas", "fa-solid fa-bell", "Alertas", "Operação"),
        ("recomendacoes", "fa-solid fa-brain", "Recomend.", "Operação"), ("clima", "fa-solid fa-cloud-sun", "Clima", "Operação"),
        ("estoque", "fa-solid fa-boxes-stacked", "Estoque", "Operação"), ("drone", "fa-solid fa-helicopter", "Drone", "Operação"),
        ("catalogo", "fa-solid fa-flask-vial", "Bioinsumos", "Gestão"), ("whatsapp", "fa-solid fa-comments", "WhatsApp", "Gestão"),
        ("propriedades", "fa-solid fa-tractor", "Fazendas", "Gestão") };

    protected override async Task OnInitializedAsync()
    {
        S.Mudou += Refresh;
        await S.CarregarAsync();
        Guard();
    }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            online = await JS.InvokeAsync<bool>("agro.online");
            await JS.InvokeVoidAsync("agro.watchOnline", DotNetObjectReference.Create(this));
            StateHasChanged();
        }
    }
    protected override void OnParametersSet() => Guard();
    void Guard() { if (S.Carregado && !S.Autenticado && !Nav.Uri.Contains("/login")) Nav.NavigateTo("/login"); }
    void Refresh() => InvokeAsync(StateHasChanged);
    [JSInvokable] public void SetOnline(bool v) { online = v; StateHasChanged(); }
    async Task Troca(ChangeEventArgs e) => await S.SelecionarAsync(int.Parse(e.Value!.ToString()!));
    async Task Sair() { await S.SairAsync(); Nav.NavigateTo("/login"); }
    public void Dispose() => S.Mudou -= Refresh;
}
